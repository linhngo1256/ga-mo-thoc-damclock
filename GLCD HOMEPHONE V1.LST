 329          unsigned int tinhlich(unsigned char ngayduong,thangduong,nam)
 330          {
 331   1        unsigned int songay,t5;
 332   1        unsigned char ngayam,thangam;
 333   1        ngayduong   = hex_dec(ngayduong);
 334   1        thangduong  = hex_dec(thangduong);
 335   1        nam     = hex_dec(nam);
 336   1      if(nam%4==0) songay=count_year[nam]+count_month1[thangduong]+ngayduong;
 337   1      else songay=count_year[nam]+count_month[thangduong]+ngayduong; 
 338   1      songay--; 
