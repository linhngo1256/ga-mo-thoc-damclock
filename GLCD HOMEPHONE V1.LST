 348   2      }
 349   1          if(songay==0) { if(lich[t5-1]>16) { thangam=lich[t5-1]-16; ngayam=30; }
 350   2                          else              { thangam=lich[t5-1];    ngayam=29; } }
 351   1        else            { if(lich[t5-1]>16) { thangam=lich[t5-1]-16; ngayam=songay+30; }
 352   2                          else              { thangam=lich[t5-1];    ngayam=songay+29; } }
 353   1      
 354   1        ngayam  = dec_hex(ngayam);
 355   1        thangam = dec_hex(thangam);
 356   1        t5= thangam << 8  ;
 357   1        t5 = t5 + ngayam;
 358   1        return(t5);
 359   1      }
